generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String               @id @default(cuid())
  githubId          String               @unique
  username          String               @unique
  email             String?
  avatarUrl         String?
  platformRole      PlatformRole         @default(USER)
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  devices           Device[]
  githubCredential  GitHubCredential?
  notifications     Notification[]
  orgMemberships    OrganizationMember[]
  ownedRepositories Repository[]         @relation("RepositoryOwner")
  membersAdded      RepositoryMember[]   @relation("MembershipAddedBy")
  memberships       RepositoryMember[]   @relation("RepositoryMembership")
  sessions          Session[]

  @@index([platformRole])
  @@index([active])
}

model GitHubCredential {
  id                   String   @id @default(cuid())
  encryptedAccessToken String
  tokenType            String?
  scope                String?
  userId               String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model Organization {
  id           String               @id @default(cuid())
  githubOrgId  String               @unique
  login        String               @unique
  name         String?
  avatarUrl    String?
  type         OrgType              @default(ORGANIZATION)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  members      OrganizationMember[]
  repositories Repository[]
}

model OrganizationMember {
  id           String       @id @default(cuid())
  role         OrgRole      @default(MEMBER)
  status       MemberStatus @default(ACTIVE)
  orgId        String
  userId       String
  syncedAt     DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId, status])
  @@index([orgId, status])
}

model Repository {
  id            String             @id @default(cuid())
  githubRepoId  String             @unique
  name          String
  fullName      String
  htmlUrl       String
  cloneUrl      String?
  defaultBranch String             @default("main")
  language      String?
  private       Boolean            @default(false)
  webhookId     String?            @unique
  isActive      Boolean            @default(true)
  ownerId       String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  orgId         String
  analysisJobs  AnalysisJob[]
  findings      Finding[]
  snapshots     HealthSnapshot[]
  notifications Notification[]
  pullRequests  PullRequest[]
  qualityGate   QualityGate?
  organization  Organization       @relation(fields: [orgId], references: [id])
  owner         User               @relation("RepositoryOwner", fields: [ownerId], references: [id])
  members       RepositoryMember[]

  @@index([fullName])
  @@index([ownerId, isActive])
  @@index([orgId, isActive])
}

model RepositoryMember {
  id         String         @id @default(cuid())
  role       RepositoryRole @default(DEVELOPER)
  status     MemberStatus   @default(ACTIVE)
  userId     String
  repoId     String
  addedById  String?
  addedAt    DateTime       @default(now())
  removedAt  DateTime?
  updatedAt  DateTime       @updatedAt
  addedBy    User?          @relation("MembershipAddedBy", fields: [addedById], references: [id])
  repository Repository     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  user       User           @relation("RepositoryMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repoId])
  @@index([repoId, status])
  @@index([addedById])
}

model PullRequest {
  id              String        @id @default(cuid())
  prNumber        Int
  title           String
  authorLogin     String
  htmlUrl         String
  headBranch      String
  baseBranch      String
  headSha         String
  status          PRStatus      @default(OPEN)
  repoId          String
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?
  mergedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  analysisJobs    AnalysisJob[]
  repository      Repository    @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, prNumber])
  @@index([repoId, status])
  @@index([repoId, updatedAt(sort: Desc)])
}

model AnalysisJob {
  id            String          @id @default(cuid())
  status        AnalysisStatus  @default(PENDING)
  trigger       AnalysisTrigger @default(WEBHOOK)
  progress      Int             @default(0)
  branch        String
  commitSha     String
  bullJobId     String?         @unique
  retryCount    Int             @default(0)
  errorMessage  String?
  repoId        String
  pullRequestId String?
  queuedAt      DateTime        @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  updatedAt     DateTime        @updatedAt
  pullRequest   PullRequest?    @relation(fields: [pullRequestId], references: [id])
  repository    Repository      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  snapshot      HealthSnapshot?

  @@index([repoId, status])
  @@index([status, queuedAt])
  @@index([pullRequestId])
  @@index([repoId, queuedAt(sort: Desc)])
}

model HealthSnapshot {
  id                   String         @id @default(cuid())
  healthScore          Float
  debtMinutes          Float          @default(0)
  debtDeltaMinutes     Float          @default(0)
  vulnerabilityCount   Int            @default(0)
  criticalCount        Int            @default(0)
  highCount            Int            @default(0)
  mediumCount          Int            @default(0)
  lowCount             Int            @default(0)
  complexityCount      Int            @default(0)
  duplicationCount     Int            @default(0)
  codeSmellCount       Int            @default(0)
  maintainabilityCount Int            @default(0)
  duplicationPct       Float          @default(0)
  totalIssues          Int            @default(0)
  linesOfCode          Int            @default(0)
  gateResult           GateResult?
  rawMetrics           Json?
  analysisId           String         @unique
  repoId               String
  calculatedAt         DateTime       @default(now())
  findings             Finding[]
  analysis             AnalysisJob    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  repository           Repository     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  notifications        Notification[]

  @@index([repoId, calculatedAt(sort: Desc)])
  @@index([calculatedAt(sort: Desc)])
}

model Finding {
  id          String          @id @default(cuid())
  file        String?
  line        Int?
  endLine     Int?
  column      Int?
  endColumn   Int?
  severity    Severity
  category    FindingCategory
  state       FindingState    @default(NEW)
  rule        String
  message     String
  tool        String
  debtMinutes Float           @default(5)
  snapshotId  String
  repoId      String
  createdAt   DateTime        @default(now())
  repository  Repository      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  snapshot    HealthSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, category])
  @@index([snapshotId, severity])
  @@index([snapshotId, state])
  @@index([snapshotId, file])
  @@index([repoId, severity])
  @@index([repoId, state])
}

model QualityGate {
  id                  String     @id @default(cuid())
  minHealthScore      Float      @default(60)
  maxCriticalFindings Int?
  maxVulnerabilities  Int?
  maxDuplicationPct   Float?
  maxComplexityCount  Int?
  maxCodeSmellCount   Int?
  blockPR             Boolean    @default(false)
  repoId              String     @unique
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  repository          Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  title      String
  body       String
  data       Json?
  readAt     DateTime?
  userId     String
  repoId     String?
  snapshotId String?
  createdAt  DateTime         @default(now())
  repository Repository?      @relation(fields: [repoId], references: [id])
  snapshot   HealthSnapshot?  @relation(fields: [snapshotId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([repoId])
  @@index([snapshotId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt, createdAt(sort: Desc)])
}

model Device {
  id             String         @id @default(cuid())
  expoPushToken  String         @unique
  platform       DevicePlatform
  deviceName     String?
  installationId String?        @unique
  active         Boolean        @default(true)
  lastUsedAt     DateTime?
  userId         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

enum PlatformRole {
  ADMIN
  USER
}

enum OrgType {
  USER
  ORGANIZATION
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum RepositoryRole {
  TEAM_LEAD
  DEVELOPER
  VIEWER
}

enum MemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AnalysisTrigger {
  WEBHOOK
  MANUAL
  SCHEDULED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingCategory {
  VULNERABILITY
  COMPLEXITY
  DUPLICATION
  CODE_SMELL
  MAINTAINABILITY
}

enum FindingState {
  NEW
  EXISTING
  RESOLVED
  UNKNOWN
}

enum PRStatus {
  OPEN
  CLOSED
  MERGED
}

enum GateResult {
  PASS
  FAIL
}

enum NotificationType {
  ANALYSIS_STARTED
  ANALYSIS_COMPLETED
  ANALYSIS_FAILED
  QUALITY_GATE_FAILED
  SCORE_DROPPED
  CRITICAL_FINDING
  MEMBER_ADDED
}

enum DevicePlatform {
  IOS
  ANDROID
}
