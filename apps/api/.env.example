# copy to .env

PORT=4000
NODE_ENV=development

# fatal, error, warn, info, debug, trace
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/code_review_db

REDIS_URL=redis://localhost:6379

# from github.com/settings/developers, callback url must match exactly
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/auth/github/callback

# used to verify webhook signatures
GITHUB_WEBHOOK_SECRET=

# must be public, use ngrok locally
GITHUB_WEBHOOK_URL=http://localhost:4000/webhooks/github

JWT_SECRET=

WEB_APP_URL=http://localhost:5173

# comma separated, no wildcard
WEB_APP_ORIGINS=http://localhost:5173

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# use COOKIE_SAMESITE=none if web and API are on different sites
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# login without GitHub, ignored in production
ENABLE_DEV_LOGIN=true

# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# bull board at /admin/queues
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=admin

# optional, only for expo enhanced push security
EXPO_ACCESS_TOKEN=
