# Copy this file to .env and fill in real values for local development.

PORT=4000
NODE_ENV=development

# Log verbosity for the Pino logger. One of: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# PostgreSQL connection string used by @codehealth/db (see packages/db/.env.example).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/code_review_db

# Redis connection string backing the BullMQ analysis queue. Matches the
# redis service in docker-compose.yml.
REDIS_URL=redis://localhost:6379

# GitHub OAuth App credentials (github.com/settings/developers).
# Authorization callback URL on the OAuth App must match this exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Shared secret configured on the GitHub webhook; used to verify the
# X-Hub-Signature-256 HMAC-SHA256 signature on incoming webhook payloads.
GITHUB_WEBHOOK_SECRET=

# Public URL GitHub delivers webhook events to. Set on each hook registered
# when a repository is linked, so GitHub has to be able to reach it — during
# local development use a tunnel (e.g. https://<id>.ngrok.io/webhooks/github).
GITHUB_WEBHOOK_URL=http://localhost:4000/webhooks/github

# Secret used to sign both the access token and the short-lived OAuth `state`
# param. The two carry a `typ` claim so one can't be used as the other.
JWT_SECRET=

# Where the OAuth callback redirects the browser after a successful login.
WEB_APP_URL=http://localhost:5173

# Comma-separated origins allowed to send cookies to this API. A wildcard will
# not work here — browsers reject "*" on credentialed requests.
WEB_APP_ORIGINS=http://localhost:5173

# Access tokens are short-lived because they can't be revoked; the refresh
# token in the database is what actually controls session lifetime.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Refresh cookie flags. Defaults to secure only in production so plain-HTTP
# localhost still works. Set COOKIE_SAMESITE=none if the web app and API are
# on different sites (e.g. Vercel + Railway) — that also forces Secure on.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Enables POST /auth/dev-login, which signs in as any username without GitHub.
# Ignored when NODE_ENV=production, and the route isn't even registered.
ENABLE_DEV_LOGIN=true

# 32-byte key (64 hex characters) used to AES-256-GCM encrypt the GitHub
# access token before it is stored in GitHubCredential.encryptedAccessToken.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
