# fixed config for every scanned repo, their own pylintrc is ignored

[MAIN]
# vendored, generated and virtualenv code
ignore=.venv,venv,env,__pycache__,site-packages,node_modules,build,dist,migrations

# no cache, so the same commit always scores the same
persistent=no

[MESSAGES CONTROL]
# we don't install their dependencies, so import errors aren't their fault
disable=import-error,
        # already reported by other tools/rules
        fixme,
        duplicate-code,
        too-many-positional-arguments
