# Copy this file to .env and fill in real values for local development.

NODE_ENV=development

# Log verbosity for the Pino logger. One of: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# PostgreSQL connection string used by @codehealth/db. Must be the same database
# the API writes to — the worker updates the AnalysisJob rows the API created.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/code_review_db

# Redis connection string. Must match the API's REDIS_URL, otherwise the worker
# is listening to a different queue than the one jobs are added to.
REDIS_URL=redis://localhost:6380

# How many jobs this worker runs at once.
WORKER_CONCURRENCY=2

# Must be the exact same key as the API's TOKEN_ENCRYPTION_KEY — the worker
# decrypts the GitHub tokens the API encrypted, to clone private repos.
TOKEN_ENCRYPTION_KEY=

# Milliseconds before a git clone is given up on.
CLONE_TIMEOUT_MS=120000
