# copy to .env

NODE_ENV=development

# fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# same db as the API
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/code_review_db

# same as the API's REDIS_URL
REDIS_URL=redis://localhost:6380

WORKER_CONCURRENCY=2

# same as the API's key
TOKEN_ENCRYPTION_KEY=

CLONE_TIMEOUT_MS=120000

# worker sends results here
API_BASE_URL=http://localhost:4000

# must match an Agent row, the seed creates this one
AGENT_TOKEN=dev_agent_token

# both must match the API's
GITHUB_WEBHOOK_URL=http://localhost:4000/webhooks/github
GITHUB_WEBHOOK_SECRET=
